# Required: choose a private password before running.
ADMIN_PASSWORD=change-this-before-the-event
PORT=3001
DATABASE_PATH=./data/competition.sqlite
QUESTION_DIR=./questions
# Set true when serving over HTTPS. Leave false for local HTTP/LAN use.
COOKIE_SECURE=false
# Set to 1 only behind exactly one trusted reverse proxy.
TRUST_PROXY=0
