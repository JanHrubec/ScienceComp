{
  "name": "science-competition",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file=.env dist/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "simulate": "tsx server/game/simulate.ts"
  },
  "dependencies": {
    "express": "^5.1.0", "express-rate-limit": "^8.0.0", "vue": "^3.5.0", "vue-router": "^4.5.0", "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0", "@types/express": "^5.0.0", "@types/node": "^24.0.0", "@vitejs/plugin-vue": "^6.0.0", "concurrently": "^9.2.0", "tsx": "^4.20.0", "typescript": "~5.9.0", "vite": "^7.1.0", "vue-tsc": "^3.0.0"
  }
}
